<Window x:Class="MurzilaBrowser.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" Background="#0e1116" Foreground="#f5f7fb"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1c2230"/>
            <Setter Property="Foreground" Value="#f5f7fb"/>
            <Setter Property="BorderBrush" Value="#2a3242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1c2230"/>
            <Setter Property="Foreground" Value="#f5f7fb"/>
            <Setter Property="BorderBrush" Value="#2a3242"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Настройки браузера" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Поисковая система" Foreground="#9aa4b7" Margin="0,0,0,6"/>
            <ComboBox x:Name="SearchBox" ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}"/>

            <TextBlock Text="Производительность" Foreground="#9aa4b7" Margin="0,20,0,6"/>
            <CheckBox x:Name="LowEndCheck" Content="Экономичный режим (меньше лагов, 4K легче)" Foreground="#f5f7fb" Margin="0,4"/>
            <CheckBox x:Name="GpuCheck" Content="Аппаратное ускорение" Foreground="#f5f7fb" Margin="0,4"/>
            <CheckBox x:Name="FullscreenCheck" Content="Открывать в полноэкранном режиме" Foreground="#f5f7fb" Margin="0,4"/>

            <TextBlock Text="Масштаб страниц" Foreground="#9aa4b7" Margin="0,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="ZoomSlider" Minimum="50" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                        Width="360" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#4f8cff"/>
            </StackPanel>

            <TextBlock Text="Функции" Foreground="#9aa4b7" Margin="0,20,0,6"/>
            <CheckBox x:Name="VoiceCheck" Content="Голосовой перевод и субтитры" Foreground="#f5f7fb" Margin="0,4"/>
            <CheckBox x:Name="LiveCheck" Content="Живые голоса" Foreground="#f5f7fb" Margin="0,4"/>
            <CheckBox x:Name="UpdateCheck" Content="Проверять обновления при запуске" Foreground="#f5f7fb" Margin="0,4"/>
            <TextBlock Text="Обновления приходят из приложения, интернет обязателен." Foreground="#6c778c"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="Отмена" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Click="Save_Click" Background="#4f8cff" Foreground="#07101f"/>
        </StackPanel>
    </Grid>
</Window>
