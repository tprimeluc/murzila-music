<Window x:Class="MurzilaBrowser.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="640" Width="600"
        WindowStartupLocation="CenterOwner" Background="#000000" Foreground="#ffffff"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#2a2a2a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#2a2a2a"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Настройки браузера" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Поисковая система" Foreground="#a6a6a6" Margin="0,0,0,6"/>
            <ComboBox x:Name="SearchBox" ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}"/>

            <TextBlock Text="Производительность" Foreground="#a6a6a6" Margin="0,20,0,6"/>
            <CheckBox x:Name="LowEndCheck" Content="Экономичный режим (меньше лагов, 4K легче)" Foreground="#ffffff" Margin="0,4"/>
            <CheckBox x:Name="GpuCheck" Content="Аппаратное ускорение" Foreground="#ffffff" Margin="0,4"/>
            <CheckBox x:Name="FullscreenCheck" Content="Открывать в полноэкранном режиме" Foreground="#ffffff" Margin="0,4"/>

            <TextBlock Text="Масштаб страниц" Foreground="#a6a6a6" Margin="0,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="ZoomSlider" Minimum="50" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                        Width="360" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#ffffff"/>
            </StackPanel>

            <TextBlock Text="Функции" Foreground="#a6a6a6" Margin="0,20,0,6"/>
            <CheckBox x:Name="VoiceCheck" Content="Голосовой перевод и субтитры" Foreground="#ffffff" Margin="0,4"/>
            <CheckBox x:Name="LiveCheck" Content="Живые голоса" Foreground="#ffffff" Margin="0,4"/>
            <CheckBox x:Name="UpdateCheck" Content="Проверять обновления при запуске" Foreground="#ffffff" Margin="0,4"/>
            <CheckBox x:Name="MaxPerfCheck" Content="Макс. производительность (до 100k FPS, без V-sync)" Foreground="#ffffff" Margin="0,4"/>
            <CheckBox x:Name="MillionCheck" Content="Режим 1 000 000 объектов (GPU)" Foreground="#ffffff" Margin="0,4"/>
            <TextBlock Text="Обновления приходят из приложения, интернет обязателен." Foreground="#808080"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Border BorderBrush="#2a2a2a" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="О Murzila Browser" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="AboutVersion" Text="Версия: —" Foreground="#ffffff" Margin="0,2"/>
                    <TextBlock x:Name="AboutUpdate" Text="Обновление: проверка…" Foreground="#a6a6a6" Margin="0,2"/>
                    <TextBlock x:Name="AboutBuild" Text="Сборка: —" Foreground="#a6a6a6" Margin="0,2"/>
                    <TextBlock x:Name="AboutRepo" Text="Источник: github.com/tprimeluc/murzila-music" Foreground="#a6a6a6" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AboutProfile" Text="Профиль: —" Foreground="#a6a6a6" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AboutFeatures" Text="Возможностей: 50" Foreground="#a6a6a6" Margin="0,2"/>
                    <TextBlock Text="Обновления проверяются через GitHub Releases. Для работы нужен интернет."
                               Foreground="#808080" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button x:Name="AboutCheckBtn" Content="Проверить обновление" Click="AboutCheck_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="FeaturesBtn" Content="Возможности" Click="FeaturesBtn_Click"/>
            <Button x:Name="PerfBtn" Content="1 млн объектов" Click="PerfBtn_Click"/>
            <Button x:Name="CancelBtn" Content="Отмена" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Click="Save_Click" Background="#ffffff" Foreground="#000000"/>
        </StackPanel>
    </Grid>
</Window>
