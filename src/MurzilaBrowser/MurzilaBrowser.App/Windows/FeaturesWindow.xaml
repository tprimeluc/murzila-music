<Window x:Class="MurzilaBrowser.App.Windows.FeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murzila Browser — возможности" Height="620" Width="780"
        WindowStartupLocation="CenterOwner" Background="#000000" Foreground="#ffffff"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#2a2a2a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Header" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <ListBox x:Name="FeatureList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#2a2a2a" BorderThickness="0,0,0,1" Padding="6,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Foreground="#ffffff" FontSize="12" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Feature.Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Feature.Description}" Foreground="#a6a6a6" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" HorizontalAlignment="Right"
                                       Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CheckUpdateBtn" Content="Проверить обновление" Height="34" Padding="12,0" Margin="0,0,8,0" Click="CheckUpdate_Click"/>
            <Button x:Name="VoiceBtn" Content="Проверить голос" Height="34" Padding="12,0" Margin="0,0,8,0" Click="Voice_Click"/>
            <Button x:Name="ClearHistoryBtn" Content="Очистить историю" Height="34" Padding="12,0" Click="ClearHistory_Click"/>
        </StackPanel>
    </Grid>
</Window>
