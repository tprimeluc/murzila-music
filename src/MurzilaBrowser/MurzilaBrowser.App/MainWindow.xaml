<Window x:Class="MurzilaBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MurzilaBrowser.App"
        Title="Murzila Browser" Height="760" Width="1280"
        WindowStyle="None" ResizeMode="CanResize" Background="#07090d"
        Foreground="#f5f7fb" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#07090d"/>
        <SolidColorBrush x:Key="Panel" Color="#12161f"/>
        <SolidColorBrush x:Key="Card" Color="#171c26"/>
        <SolidColorBrush x:Key="Line" Color="#232b3a"/>
        <SolidColorBrush x:Key="Text" Color="#f5f7fb"/>
        <SolidColorBrush x:Key="Muted" Color="#9aa4b7"/>
        <SolidColorBrush x:Key="Accent" Color="#4f8cff"/>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Card}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <Path Data="M5,5 L13,13 M13,5 L5,13" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a2430"/>
                                <Setter Property="Foreground" Value="#ff8b8b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="218"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0" Margin="3,4,3,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Accent}" Margin="7,0,0,0"
                                      Data="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
                                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{TemplateBinding Header}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,2,0"/>
                                <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource TabCloseButton}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="CloseTab_Click" Tag="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Card}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1b2130"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeTabsStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ItemsPresenter Grid.Row="0"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <TabPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContentTabsStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Title bar: logo, tabs, window controls -->
            <Grid Grid.Row="0" Background="{StaticResource Bg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="116"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource Accent}"
                      HorizontalAlignment="Center" Data="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
                <TabControl x:Name="Tabs" Grid.Column="1" Style="{StaticResource ChromeTabsStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="Tabs_SelectionChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Style="{StaticResource ChromeButton}" Width="36" Click="Minimize_Click" ToolTip="Свернуть">
                        <Path Data="M4,9 H16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Width="36" Click="Maximize_Click" ToolTip="Развернуть">
                        <Path Data="M4,4 H16 V16 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Width="36" Click="CloseWindow_Click" ToolTip="Закрыть">
                        <Path Data="M5,5 L15,15 M15,5 L5,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,4,0">
                    <Button Style="{StaticResource ChromeButton}" Click="Back_Click" ToolTip="Назад (Alt+Лево)">
                        <Path Data="M14,5 L7,12 L14,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Forward_Click" ToolTip="Вперёд (Alt+Право)">
                        <Path Data="M9,5 L16,12 L9,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Reload_Click" ToolTip="Обновить (F5)">
                        <Path Data="M15,7 A6,6 0 1 0 16,13 M15,4 V8 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Home_Click" ToolTip="Главная">
                        <Path Data="M4,11 L12,4 L20,11 V20 H14 V14 H10 V20 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>

                <Border Grid.Column="4" Height="34" Margin="6,0,6,0" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource Muted}" HorizontalAlignment="Center"
                              Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2c1.6 0 3 .5 4.2 1.4-.8 1.4-1.2 3-1.2 4.6 0 .5 0 1 .1 1.4-1.8-1-3.9-1.6-6.1-1.7.9-1.7 1.4-3.5 1.5-5.3H12z"/>
                        <TextBox x:Name="AddressBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                 FontSize="13" VerticalContentAlignment="Center" Padding="2,0,4,0"
                                 KeyDown="AddressBox_KeyDown"/>
                        <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Width="30" Click="Go_Click" ToolTip="Перейти">
                            <Path Data="M7,12 H17 M12,7 L17,12 L12,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="5" Style="{StaticResource ChromeButton}" Click="Features_Click" ToolTip="50 возможностей">
                    <TextBlock Text="50" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource ChromeButton}" Click="Bookmark_Click" ToolTip="Добавить закладку">
                    <Path x:Name="StarIcon" Data="M12,3 L14.6,8.6 L20.8,9.3 L16.3,13.3 L17.6,19.4 L12,16.2 L6.4,19.4 L7.7,13.3 L3.2,9.3 L9.4,8.6 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/>
                </Button>
                <Button Grid.Column="7" Style="{StaticResource ChromeButton}" Width="40" Click="NewTab_Click" ToolTip="Новая вкладка (Ctrl+T)" Margin="0,0,8,0">
                    <Path Data="M10,4 V16 M4,10 H16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Pages -->
            <TabControl x:Name="PageTabs" Grid.Row="2" Style="{StaticResource ContentTabsStyle}" Background="{StaticResource Bg}"
                        BorderThickness="0" SelectionChanged="PageTabs_SelectionChanged" Margin="0,0,0,0"/>

            <!-- Status bar -->
            <Grid Grid.Row="3" Background="{StaticResource Panel}">
                <TextBlock x:Name="StatusText" Text="готово" Foreground="{StaticResource Muted}" FontSize="10.5"
                           VerticalAlignment="Center" Margin="12,0,120,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SidecarText" Text="python: —" Foreground="{StaticResource Muted}" FontSize="10.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ProgressBar x:Name="LoadProgress" Height="2" VerticalAlignment="Top" Foreground="{StaticResource Accent}"
                             Background="Transparent" IsIndeterminate="False" Value="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
