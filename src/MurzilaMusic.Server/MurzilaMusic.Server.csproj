<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MurzilaMusic.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <None Include="..\..\tools\fpcalc\chromaprint-fpcalc-1.6.2-windows-x86_64\fpcalc.exe"
          Link="fpcalc.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\fpcalc\chromaprint-fpcalc-1.6.2-windows-x86_64\fpcalc.exe')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MurzilaMusic.Shared\Catalog*.cs" Link="Shared\Catalog\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\MurzilaMusic.Shared\catalog\plans.json"
                      Link="Shared\Catalog\plans.json" LogicalName="MurzilaMusic.Catalog.plans.json" />
  </ItemGroup>
</Project>
