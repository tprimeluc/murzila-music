<Window x:Class="MurzilaMusic.App.ArtistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:MurzilaMusic.App.Services"
        Title="Артист — Murzila-Music" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource IconButton}" Click="Back_Click">
                <Path Data="{svc:IconGeometry back}" Width="18" Height="18" Stretch="Uniform"
                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Fill="Transparent"/>
            </Button>
            <TextBlock x:Name="TbArtist" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                       Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ListBox x:Name="LbTracks" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 SelectionChanged="LbTracks_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="10" Background="{DynamicResource CardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{svc:IconGeometry play}" Width="11" Height="11" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="15" Width="330" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DisplayDuration}" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
