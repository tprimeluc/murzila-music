<Window x:Class="MurzilaMusic.App.TrackInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о треке" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbHeader" Text="Информация о треке"
                   FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock x:Name="TbSubHeader" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                   FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>

        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Название" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                           Margin="2,0,0,6"/>
                <TextBox x:Name="TbTitle" Height="40" FontSize="14"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Артист" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                           Margin="2,14,0,6"/>
                <TextBox x:Name="TbArtist" Height="40" FontSize="14"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Альбом" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                           Margin="2,14,0,6"/>
                <TextBox x:Name="TbAlbum" Height="40" FontSize="14"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Заметка (видна только тебе)" FontSize="11.5"
                           Foreground="{DynamicResource MutedBrush}" Margin="2,14,0,6"/>
                <TextBox x:Name="TbComment" Height="76" FontSize="13.5" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"/>

                <CheckBox x:Name="CbAllowExternal" Margin="0,16,0,0" FontSize="13"
                          Foreground="{DynamicResource TextBrush}"
                          Content="Разрешить другим слушать мой трек в Murzila Music (включаю я, артист)"/>

                <CheckBox x:Name="CbApplyAll" Margin="0,12,0,0" FontSize="13"
                          Foreground="{DynamicResource TextBrush}"
                          Content="Применить артиста, альбом и заметку ко всем выбранным файлам"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnSkip" Content="Без изменений" Style="{StaticResource GhostButton}"
                    Padding="16,10" Click="Skip_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource GhostButton}"
                    Padding="16,10" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                    Padding="20,10" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
