<Window x:Class="MurzilaMusic.App.PlaylistPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить в плейлист" Height="420" Width="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" ResizeMode="NoResize">
    <StackPanel Margin="26">
        <TextBlock Text="Плейлисты" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>
        <ListBox x:Name="LbPlaylists" Height="190" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"
                 Foreground="{DynamicResource TextBrush}" DisplayMemberPath="Name" MouseDoubleClick="LbPlaylists_DoubleClick"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBox x:Name="TbName" Width="230" Text="Новый плейлист"/>
            <Button Content="Создать" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Create_Click"/>
        </StackPanel>
        <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="Add_Click"/>
    </StackPanel>
</Window>
