<Window x:Class="MurzilaMusic.App.PaywallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин Murzila-Music" Height="720" Width="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Свой магазин Murzila-Music" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="TbReason" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="15" LineHeight="22"/>
            <TextBlock x:Name="TbTrack" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,10,0,0"/>
            <TextBlock x:Name="TbUserStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock x:Name="TbBalance" TextWrapping="Wrap" Foreground="{DynamicResource GoldBrush}" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock x:Name="TbPaymentMode" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       Margin="0,4,0,0"/>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                <TextBlock x:Name="TbPaymentStatus" TextWrapping="Wrap" Foreground="{DynamicResource GoldBrush}" FontSize="12"/>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Промокод" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="TbPromoCode" Height="34" Padding="8,6" Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center" FontSize="13"
                             ToolTip="Если промокод заполнен, покупка пройдёт по промокоду"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="PlansList" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding PriceRub, StringFormat='{}{0} ₽'}" FontSize="20"
                                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding LimitText}" Foreground="{DynamicResource SubtleMutedBrush}" FontSize="12"/>
                                    <TextBlock Text=" · " Foreground="{DynamicResource SubtleMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource SubtleMutedBrush}" FontSize="12"/>
                                    <TextBlock Text=" · " Foreground="{DynamicResource SubtleMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding AdsText}" Foreground="{DynamicResource SubtleMutedBrush}" FontSize="12"/>
                                </StackPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding FeatureCount, StringFormat='{}{0} функций'}"
                                               Foreground="{DynamicResource GoldBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="{Binding PriceRub, StringFormat='Купить за {0} ₽'}"
                                            Style="{StaticResource PrimaryButton}" Click="PlanBuy_Click"
                                            Tag="{Binding Id}" HorizontalAlignment="Right" MinWidth="150"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="BtnSingle" Style="{StaticResource GhostButton}" Click="SingleBuy_Click" Margin="0,0,0,10"/>
            <Button x:Name="BtnRestore" Content="Восстановить покупки" Style="{StaticResource GhostButton}"
                    Click="BtnRestore_Click" Margin="0,0,0,10"/>
            <Button x:Name="BtnLogin" Content="Войти или зарегистрироваться"
                    Style="{StaticResource GhostButton}" Click="BtnLogin_Click" Margin="0,0,0,10"/>
            <Button x:Name="BtnRetry" Content="Ещё раз проверить" Style="{StaticResource GhostButton}"
                    Click="BtnRetry_Click" Margin="0,0,0,10" Visibility="Collapsed"/>
            <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
