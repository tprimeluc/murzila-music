<Window x:Class="MurzilaMusic.App.Windows.LyricsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свой текст" Height="540" Width="720" MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TbTitle" Text="Свой текст" Foreground="{DynamicResource TextBrush}" FontSize="19"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="TbHint" Text="Вставь свой текст с метками .lrc." Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox x:Name="TbLrc" Grid.Row="1" Margin="0,16,0,0" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 Padding="12" TextWrapping="NoWrap"/>

        <TextBlock x:Name="TbExample" Grid.Row="2" Text="[00:12.34]Строка текста" Foreground="{DynamicResource SubtleMutedBrush}"
                   FontSize="11" FontFamily="Consolas" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnCancel" Content="Отмена" Width="110" Height="34" Margin="0,0,10,0"
                    Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                    Cursor="Hand" Click="Cancel_Click"/>
            <Button x:Name="BtnSave" Content="Сохранить" Width="130" Height="34"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
