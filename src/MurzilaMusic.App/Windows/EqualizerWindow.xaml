<Window x:Class="MurzilaMusic.App.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Эквалайзер — Murzila-Music" Height="740" Width="640"
        MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}">
    <Window.Resources>
        <Style x:Key="EqSlider" TargetType="Slider" BasedOn="{StaticResource WhiteSlider}">
            <Setter Property="Minimum" Value="-12"/>
            <Setter Property="Maximum" Value="12"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Height" Value="22"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Эквалайзер" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="10 полос. Двигай ползунки или выбери готовый пресет — звук меняется сразу."
                           Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <CheckBox x:Name="ChkEnabled" Content="Эквалайзер включён" Foreground="{DynamicResource TextBrush}"
                          FontSize="15" Click="Enabled_Changed"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button Tag="Ровно" Content="Ровно" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Preset_Click"/>
                    <Button Tag="Бас" Content="Бас" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Preset_Click"/>
                    <Button Tag="Вокал" Content="Вокал" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Preset_Click"/>
                    <Button Tag="Рок" Content="Рок" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Preset_Click"/>
                    <Button Tag="Поп" Content="Поп" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Preset_Click"/>
                    <Button Tag="Электро" Content="Электро" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Preset_Click"/>
                    <Button Content="Сбросить" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,8,8" Click="Reset_Click"/>
                </WrapPanel>
                <TextBlock x:Name="TbPreset" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="18,14" Margin="0,18,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Частота" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Усиление / ослабление" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="дБ" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="31 Гц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq0" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq0Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="62 Гц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq1" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq1Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="125 Гц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq2" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq2Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="250 Гц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq3" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq3Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="500 Гц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq4" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq4Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1 кГц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq5" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq5Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="2 кГц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq6" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq6Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="4 кГц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq7" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq7Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="8 кГц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq8" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq8Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="16 кГц" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="Eq9" Grid.Column="1" Style="{StaticResource EqSlider}" ValueChanged="Eq_Changed"/>
                        <TextBlock x:Name="Eq9Value" Grid.Column="2" Text="0 дБ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="Изменения слышны сразу. Настройки сохраняются на этом ПК."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                <Button Content="Закрыть" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
