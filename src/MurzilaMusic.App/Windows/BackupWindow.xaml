<Window x:Class="MurzilaMusic.App.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Резервное копирование" Height="420" Width="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Резервное копирование" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="Копии библиотеки, настроек, текстов, обложек и видео хранятся локально в %APPDATA%\MurzilaMusic\Backup."
                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"/>

        <ListBox x:Name="BackupsList" Height="180" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="TbStatus" Foreground="{DynamicResource GoldBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="BtnCreate" Content="Создать копию" Style="{StaticResource PrimaryButton}"
                    Width="150" Click="BtnCreate_Click"/>
            <Button x:Name="BtnRestore" Content="Восстановить" Style="{StaticResource GhostButton}"
                    Width="140" Margin="10,0,0,0" Click="BtnRestore_Click"/>
            <Button x:Name="BtnOpen" Content="Открыть папку" Style="{StaticResource GhostButton}"
                    Width="150" Margin="10,0,0,0" Click="BtnOpen_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
