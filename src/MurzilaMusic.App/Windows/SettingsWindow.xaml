<Window x:Class="MurzilaMusic.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Murzila-Music" Height="760" Width="920"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,12,0"/>
        </Style>

        <!-- Современный переключатель вместо обычной галочки. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                    Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource MutedBrush}" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Мягкое появление окна, без сторонних библиотек. -->
        <Storyboard x:Key="WindowIntro">
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28"/>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.28"/>
        </Storyboard>

        <!-- Перелистывание вкладок: лёгкий поворот + скольжение, без сторонних библиотек. -->
        <Storyboard x:Key="TabsFlip">
            <DoubleAnimation Storyboard.TargetName="TabsRotate" Storyboard.TargetProperty="Angle"
                             From="-3.5" To="0" Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TabsSlide" Storyboard.TargetProperty="X"
                             From="28" To="0" Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TabsHost" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1" Duration="0:0:0.26"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="26,20" Loaded="Window_Loaded">
        <Grid.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="TbSettingsSubtitle" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnDone" Grid.Column="1" Content="Готово" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Click="Done_Click"/>
        </Grid>

        <Border x:Name="TabsHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="TabsSlide"/>
                    <ScaleTransform/>
                    <RotateTransform x:Name="TabsRotate"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0"
                        SelectionChanged="Tabs_Changed">
            <TabItem Header="Внешний вид">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,10,20">
                    <StackPanel>
                        <TextBlock Text="ОБРАЩЕНИЕ" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbTy" Content="Ты" GroupName="Pronoun" Foreground="{DynamicResource TextBrush}"
                                         FontSize="14" Margin="0,0,22,0" Checked="Pronoun_Changed"/>
                            <RadioButton x:Name="RbVy" Content="Вы" GroupName="Pronoun" Foreground="{DynamicResource TextBrush}"
                                         FontSize="14" Checked="Pronoun_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="TbPronounHint" Style="{StaticResource Hint}"/>

                        <TextBlock Text="ТЕМА" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TbThemeLabel" Text="Тема оформления" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CbTheme" Grid.Column="1" Tag="Theme"
                                      SelectionChanged="Generic_Changed" Height="32" Margin="0,4,0,0"/>
                        </Grid>
                        <TextBlock x:Name="TbThemeHint" Style="{StaticResource Hint}"/>

                        <TextBlock Text="СЕЗОННЫЕ ЭФФЕКТЫ" Style="{StaticResource Section}"/>
                        <CheckBox Content="Показывать эффекты времени года" Style="{StaticResource ToggleSwitch}"
                                  Tag="SeasonalEffects" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <TextBlock Text="Зима — снег, весна — зелёные листья, лето — листья и солнце, осень — оранжевые листья."
                                   Style="{StaticResource Hint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сезон" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Tag="SeasonMode" SelectionChanged="Generic_Changed"
                                      Height="32" Margin="0,4,0,0">
                                <ComboBoxItem Content="Авто"/>
                                <ComboBoxItem Content="Зима"/>
                                <ComboBoxItem Content="Весна"/>
                                <ComboBoxItem Content="Лето"/>
                                <ComboBoxItem Content="Осень"/>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Плотность частиц" Style="{StaticResource SettingLabel}"/>
                            <Slider Grid.Column="1" Tag="ParticleDensity" Minimum="0" Maximum="80"
                                    Value="28" Height="26" Margin="0,6,0,0"
                                    ValueChanged="Generic_Changed"/>
                            <TextBlock x:Name="TbDensity" Grid.Column="2" Text="28" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="8,6,0,0"/>
                        </Grid>

                        <TextBlock Text="ИНТЕРФЕЙС" Style="{StaticResource Section}"/>
                        <CheckBox Content="Компактный список треков" Style="{StaticResource ToggleSwitch}"
                                  Tag="CompactMode" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Показывать обложку на экране «Сейчас играет»" Style="{StaticResource ToggleSwitch}"
                                  Tag="ShowNowPlayingCover" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Визуализатор FFT" Style="{StaticResource ToggleSwitch}"
                                  Tag="ShowVisualizer" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Подсказка про Bluetooth-колонку" Style="{StaticResource ToggleSwitch}"
                                  Tag="BluetoothHint" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Плеер">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,10,20">
                    <StackPanel>
                        <TextBlock Text="ВОСПРОИЗВЕДЕНИЕ" Style="{StaticResource Section}"/>
                        <CheckBox Content="Перемешивание" Style="{StaticResource ToggleSwitch}"
                                  Tag="Shuffle" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Повтор" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Tag="RepeatMode" SelectionChanged="Generic_Changed"
                                      Height="32" Margin="0,4,0,0">
                                <ComboBoxItem Content="Выключен" Tag="0"/>
                                <ComboBoxItem Content="Весь список" Tag="1"/>
                                <ComboBoxItem Content="Один трек" Tag="2"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox Content="Автоматически играть следующий трек" Style="{StaticResource ToggleSwitch}"
                                  Tag="AutoPlayNext" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Запоминать громкость" Style="{StaticResource ToggleSwitch}"
                                  Tag="RememberVolume" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Показывать остаток времени" Style="{StaticResource ToggleSwitch}"
                                  Tag="ShowRemainingTime" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Горячие клавиши" Style="{StaticResource ToggleSwitch}"
                                  Tag="EnableHotkeys" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <TextBlock Text="Up/Down — громкость, M — звук, L — текст, S — перемешивание, R — повтор, Left/Right — перемотка."
                                   Style="{StaticResource Hint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Секунд перемотки стрелками" Style="{StaticResource SettingLabel}"/>
                            <Slider Grid.Column="1" Tag="SeekSeconds" Minimum="1" Maximum="30" Value="5"
                                    Height="26" Margin="0,6,0,0" ValueChanged="Generic_Changed"/>
                            <TextBlock x:Name="TbSeek" Grid.Column="2" Text="5" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="8,6,0,0"/>
                        </Grid>

                        <TextBlock Text="БИБЛИОТЕКА" Style="{StaticResource Section}"/>
                        <CheckBox Content="Счётчик прослушиваний" Style="{StaticResource ToggleSwitch}"
                                  Tag="ShowPlayCounts" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Подтверждать удаление из библиотеки" Style="{StaticResource ToggleSwitch}"
                                  Tag="ConfirmBeforeDelete" Checked="Generic_Changed" Unchecked="Generic_Changed"/>

                        <TextBlock Text="ЗВУКОВОЕ УСТРОЙСТВО" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Куда выводить звук" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CbOutput" Grid.Column="1" Height="32" Margin="0,4,0,0"
                                      SelectionChanged="Output_Changed"/>
                        </Grid>
                        <Button Content="Настройки звука и Bluetooth…" Style="{StaticResource GhostButton}"
                                Padding="14,8" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OpenSoundSettings_Click"/>
                        <TextBlock Text="Сменить колонку можно и кнопкой Volume — в плеере — без захода в настройки."
                                   Style="{StaticResource Hint}"/>

                        <TextBlock Text="ЭКВАЛАЙЗЕР" Style="{StaticResource Section}"/>
                        <Button x:Name="BtnEqualizer" Content="🎚 Открыть эквалайзер" Style="{StaticResource GhostButton}"
                                Padding="14,8" HorizontalAlignment="Left" Click="Eq_Click"/>
                        <TextBlock x:Name="TbEqStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Текст и караоке">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,10,20">
                    <StackPanel>
                        <TextBlock Text="СИНХРОНИЗАЦИЯ" Style="{StaticResource Section}"/>
                        <CheckBox Content="Загружать текст автоматически" Style="{StaticResource ToggleSwitch}"
                                  Tag="AutoLoadLyrics" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Клик по слову перематывает к звучанию" Style="{StaticResource ToggleSwitch}"
                                  Tag="LyricsClickToSeek" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Плавная побуквенная анимация 60 fps" Style="{StaticResource ToggleSwitch}"
                                  Tag="KaraokeAnimation" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Мягкое свечение активной строки" Style="{StaticResource ToggleSwitch}"
                                  Tag="LyricsGlow" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Сохранять текст в кэш" Style="{StaticResource ToggleSwitch}"
                                  Tag="SaveLyricsCache" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Размер букв" Style="{StaticResource SettingLabel}"/>
                            <Slider Grid.Column="1" Tag="LyricsFontSize" Minimum="16" Maximum="40" Value="25"
                                    Height="26" Margin="0,6,0,0" ValueChanged="Generic_Changed"/>
                            <TextBlock x:Name="TbFont" Grid.Column="2" Text="25" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="8,6,0,0"/>
                        </Grid>

                        <TextBlock Text="ИСТОЧНИКИ ТЕКСТА" Style="{StaticResource Section}"/>
                        <CheckBox Content="Предпочитать enhanced-LRC с пословными метками" Style="{StaticResource ToggleSwitch}"
                                  Tag="PreferEnhancedLyrics" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="LRCLib — основной открытый источник" Style="{StaticResource ToggleSwitch}"
                                  Tag="UseLrclib" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Genius — дополнительный поиск" Style="{StaticResource ToggleSwitch}"
                                  Tag="UseGenius" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Musixmatch — дополнительный поиск" Style="{StaticResource ToggleSwitch}"
                                  Tag="UseMusixmatch" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <TextBlock x:Name="TbLyricsSourcesHint" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Аккаунт и оплата">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,10,20">
                    <StackPanel>
                        <TextBlock Text="АККАУНТ" Style="{StaticResource Section}"/>
                        <TextBlock x:Name="TbAccountStatus" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,6">
                            <Button x:Name="BtnAccountAction" Content="Войти или зарегистрироваться"
                                    Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,8"
                                    Click="Account_Click"/>
                            <Button x:Name="BtnLogout" Content="Выйти" Style="{StaticResource GhostButton}"
                                    Padding="14,8" Margin="0,0,8,8" Click="Logout_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                        <TextBlock x:Name="TbOnlineStatus" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TbOnlineDetails" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <CheckBox Content="Регистрация только с кодом подтверждения" Style="{StaticResource ToggleSwitch}"
                                  Tag="RequireEmailCode" Checked="Generic_Changed" Unchecked="Generic_Changed"/>
                        <CheckBox Content="Показывать вход через Google" Style="{StaticResource ToggleSwitch}"
                                  Tag="GoogleSignIn" Checked="Generic_Changed" Unchecked="Generic_Changed"/>

                        <TextBlock Text="ТАРИФ" Style="{StaticResource Section}"/>
                        <WrapPanel>
                            <Button Tag="0" Content="Бесплатный 0 ₽" Style="{StaticResource GhostButton}" Click="Tariff_Click" Margin="0,0,8,8"/>
                            <Button Tag="50" Content="Про 50 ₽" Style="{StaticResource GhostButton}" Click="Tariff_Click" Margin="0,0,8,8"/>
                            <Button Tag="105" Content="Премиум 105 ₽" Style="{StaticResource GhostButton}" Click="Tariff_Click" Margin="0,0,8,8"/>
                            <Button Tag="200" Content="Ультра 200 ₽" Style="{StaticResource GhostButton}" Click="Tariff_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="TbTariff" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Сеть">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,10,20">
                    <StackPanel>
                        <TextBlock Text="ВЕБ-ПЛЕЕР И API" Style="{StaticResource Section}"/>
                        <TextBlock Text="Добавил трек в приложении — он сразу появился в веб-плеере. Отдельная кнопка «Опубликовать» не нужна."
                                   Foreground="{DynamicResource AccentBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Открыть веб-плеер" Style="{StaticResource GhostButton}"
                                    Click="OpenWebPlayer_Click" Margin="0,0,8,8"/>
                            <Button Content="Получить API-токен" Style="{StaticResource GhostButton}"
                                    Click="OpenApiToken_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Text="http://localhost:6001/player · http://localhost:6001/api/token"
                                   Style="{StaticResource Hint}"/>

                        <TextBlock Text="ПРИВАТНОСТЬ" Style="{StaticResource Section}"/>
                        <TextBlock Text="Murzila-Music не скачивает музыку с других сайтов. Добавляй только свои записи."
                                   Foreground="{DynamicResource AccentBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="Токены и пароли сохраняются локально; данные карт вводятся только на странице платёжного провайдера."
                                   Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
