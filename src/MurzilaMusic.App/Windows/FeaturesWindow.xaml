<Window x:Class="MurzilaMusic.App.FeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MurzilaMusic.App.Converters"
        Title="Murzila-Music" Height="720" Width="1020"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="WindowIntro">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="IntroTranslate" Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <conv:CategoryToIconConverter x:Key="CategoryIcon"/>

        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False"
                                           Foreground="{DynamicResource SubtleMutedBrush}" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <DataTemplate x:Key="FeatureCardTemplate">
            <Border Width="292" MinHeight="116" Margin="0,0,14,14" Padding="15"
                    Background="{DynamicResource CardBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                            Background="{DynamicResource RowSelectedBrush}" Margin="0,0,11,0">
                        <Path Data="{Binding Category, Converter={StaticResource CategoryIcon}}"
                              Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.9" Fill="Transparent"/>
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,11,0,0"
                               Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                               Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Opacity="0.85"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="IntroTranslate"/>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="30,24,24,18" Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TbTitle" FontSize="27" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <Border Margin="12,2,0,0" Padding="9,4" CornerRadius="10" Background="{DynamicResource RowSelectedBrush}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TbOnlineBadge" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TbSubtitle" Margin="0,8,0,0" MaxWidth="760"
                               FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnClose" Grid.Column="1" Width="86" Height="36"
                        VerticalAlignment="Top" Margin="18,0,0,0" Click="BtnClose_Click"
                        Style="{StaticResource GhostButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="30,14,30,10" Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbSearch" Style="{StaticResource FilterBox}" TextChanged="Search_Changed"/>
                <TextBlock x:Name="TbCount" Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <ComboBox x:Name="CbCategory" Grid.Column="2" Style="{StaticResource FilterCombo}"
                          SelectionChanged="Category_Changed"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="30,8,16,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl x:Name="FeaturesList" ItemTemplate="{StaticResource FeatureCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="TbEmpty" Visibility="Collapsed" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="3" Padding="30,14" Background="{DynamicResource PanelBrush}">
            <TextBlock x:Name="TbFooter" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
    </Grid>
</Window>
