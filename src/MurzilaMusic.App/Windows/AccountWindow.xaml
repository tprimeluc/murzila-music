<Window x:Class="MurzilaMusic.App.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунт — Murzila-Music" Height="760" Width="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TbTitle" Text="Аккаунт" FontSize="27" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="TbSubtitle" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Вход / регистрация -->
                <StackPanel x:Name="GuestPanel">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbLoginTab" Content="Вход" GroupName="AccountTab"
                                     Foreground="{DynamicResource TextBrush}" FontSize="15" IsChecked="True"
                                     Margin="0,0,24,0" Checked="Tab_Changed"/>
                        <RadioButton x:Name="RbRegisterTab" Content="Регистрация" GroupName="AccountTab"
                                     Foreground="{DynamicResource TextBrush}" FontSize="15" Checked="Tab_Changed"/>
                    </StackPanel>

                    <Grid>
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="Почта" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                            <TextBox x:Name="TbLoginEmail" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"/>
                            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PbLoginPassword" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"
                                         KeyDown="LoginPassword_KeyDown"/>
                            <Button x:Name="BtnForgot" Content="Забыл(-и) пароль?"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="Forgot_Click"/>
                            <Button x:Name="BtnLogin" Content="Войти" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="Login_Click"/>
                            <Button x:Name="BtnLoginCode" Content="Войти по коду из письма"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0" Click="LoginCode_Click"/>
                            <Button x:Name="BtnPhoneLogin" Content="Войти по SMS"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0" Click="PhoneLogin_Click"/>
                            <TextBlock x:Name="TbNoAccount" Text="Нет аккаунта? Открой вкладку «Регистрация»."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                            <TextBlock Text="Имя" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                            <TextBox x:Name="TbRegName" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"/>
                            <TextBlock Text="Почта" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbRegEmail" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"/>
                            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PbRegPassword" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"/>
                            <TextBlock x:Name="TbRepeatPassword" Text="Повтори пароль" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PbRegConfirm" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"
                                         KeyDown="RegisterConfirm_KeyDown"/>
                            <Button x:Name="BtnRegister" Content="Зарегистрироваться"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,22,0,0" Click="Register_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Восстановление пароля -->
                    <Border x:Name="ForgotPanel" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                            CornerRadius="12" Padding="16" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TbForgotTitle" Text="Восстановление пароля"
                                       Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TbForgotInfo" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Почта аккаунта" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbForgotEmail" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"/>
                            <Button x:Name="BtnForgotRequest" Content="Получить код"
                                    Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    Click="ForgotRequest_Click"/>

                            <StackPanel x:Name="ForgotCodeGroup" Visibility="Collapsed">
                                <TextBlock Text="Код из письма" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbForgotCode" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="40" FontSize="20" MaxLength="6"
                                             TextAlignment="Center"
                                             KeyDown="ForgotCode_KeyDown"/>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" ToolTip="Копировать код"
                                            Tag="{Binding ElementName=TbForgotCode}" Click="CopyCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M8,8 L20,8 L20,20 L8,20 Z M5,16 L5,4 L16,4"/>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                                            Margin="4,0,0,0" ToolTip="Вставить код"
                                            Tag="{Binding ElementName=TbForgotCode}" Click="PasteCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M9,4 L15,4 L15,7 L9,7 Z M7,6 L4,6 L4,21 L20,21 L20,6 L17,6 M9,12 L15,12 M9,16 L15,16"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="PbForgotNew" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"/>
                                <Button x:Name="BtnForgotReset" Content="Сменить пароль и войти"
                                        Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                        Click="ForgotReset_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TbForgotHint" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock x:Name="TbForgotError" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Button x:Name="BtnForgotBack" Content="Назад" Style="{StaticResource SmallButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="ForgotBack_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Вход по SMS -->
                    <Border x:Name="PhoneLoginPanel" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                            CornerRadius="12" Padding="16" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Вход по SMS" Foreground="{DynamicResource TextBrush}" FontSize="15"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TbPhoneLoginInfo" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbPhoneLoginPhone" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="38" FontSize="14"
                                     ToolTip="+7 999 123-45-67"/>
                            <Button x:Name="BtnPhoneLoginRequest" Content="Отправить код"
                                    Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    Click="PhoneLoginRequest_Click"/>
                            <StackPanel x:Name="PhoneLoginCodeGroup" Visibility="Collapsed">
                                <TextBlock Text="Код из SMS" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbPhoneLoginCode" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="40" FontSize="20" MaxLength="6"
                                             TextAlignment="Center" KeyDown="PhoneLoginCode_KeyDown"/>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" Tag="{Binding ElementName=TbPhoneLoginCode}"
                                            Click="CopyCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M8,8 L20,8 L20,20 L8,20 Z M5,16 L5,4 L16,4"/>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                                            Margin="4,0,0,0" Tag="{Binding ElementName=TbPhoneLoginCode}"
                                            Click="PasteCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M9,4 L15,4 L15,7 L9,7 Z M7,6 L4,6 L4,21 L20,21 L20,6 L17,6 M9,12 L15,12 M9,16 L15,16"/>
                                    </Button>
                                </Grid>
                                <Button x:Name="BtnPhoneLoginVerify" Content="Войти"
                                        Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                        Click="PhoneLoginVerify_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TbPhoneLoginHint" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock x:Name="TbPhoneLoginError" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Button x:Name="BtnPhoneLoginBack" Content="Назад" Style="{StaticResource SmallButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="PhoneLoginBack_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Подтверждение регистрации / входа -->
                    <Border x:Name="CodePanel" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                            CornerRadius="12" Padding="16" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TbCodeTitle" Text="Код подтверждения"
                                       Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TbCodeSent" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBox x:Name="TbCode" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="40" FontSize="20" MaxLength="6"
                                     Margin="0,12,0,0" TextAlignment="Center"
                                     ToolTip="6 цифр из письма" KeyDown="Code_KeyDown"/>
                            <Button x:Name="BtnVerifyCode" Content="Подтвердить и войти"
                                    Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    Click="VerifyCode_Click"/>
                            <Button x:Name="BtnResendCode" Content="Запросить новый код"
                                    Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Click="ResendCode_Click"/>
                            <TextBlock x:Name="TbCodeHint" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TbError" Foreground="{DynamicResource DangerBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>

                    <Button x:Name="BtnGoogle" Content="Войти через Google"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                            Margin="0,16,0,0" Click="Google_Click"/>

                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                        <TextBlock x:Name="TbHint" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Профиль -->
                <StackPanel x:Name="ProfilePanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource CardBrush}">
                            <TextBlock x:Name="TbInitial" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TbProfileName" Foreground="{DynamicResource TextBrush}" FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TbProfileEmail" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Тариф" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="TbProfileTariff" Foreground="{DynamicResource AccentBrush}" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TbProfilePlan" Foreground="{DynamicResource GoldBrush}" FontSize="13"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TbProfileBalance" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="TbProfileHint" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TbProfileStatus" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnStore" Content="Магазин" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,14,0,0" Click="Store_Click"/>
                    <Button x:Name="BtnRestore" Content="Восстановить покупки" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="Restore_Click"/>
                    <Button x:Name="BtnRefund" Content="Возврат на баланс" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="Refund_Click"/>

                    <TextBlock Text="Покупки" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,18,0,6"/>
                    <ItemsControl x:Name="OrdersList" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Безопасность и вход -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="БЕЗОПАСНОСТЬ И ВХОД" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

                            <TextBlock Text="Смена пароля" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                            <PasswordBox x:Name="PbCurrentPassword" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="34" FontSize="13"
                                         Margin="0,6,0,0" ToolTip="Текущий пароль"/>
                            <PasswordBox x:Name="PbNewPassword" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="34" FontSize="13"
                                         Margin="0,6,0,0" ToolTip="Новый пароль"/>
                            <Button x:Name="BtnChangePassword" Content="Сменить пароль"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="ChangePassword_Click"/>

                            <TextBlock Text="Смена почты" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,16,0,0"/>
                            <TextBox x:Name="TbNewEmail" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="34" FontSize="13" Margin="0,6,0,0"
                                     ToolTip="Новая почта"/>
                            <Button x:Name="BtnChangeEmailRequest" Content="Отправить код на новую почту"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="ChangeEmailRequest_Click"/>
                            <StackPanel x:Name="EmailCodeGroup" Visibility="Collapsed">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbEmailCode" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="36" FontSize="16" MaxLength="6"
                                             TextAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" Tag="{Binding ElementName=TbEmailCode}"
                                            Click="CopyCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M8,8 L20,8 L20,20 L8,20 Z M5,16 L5,4 L16,4"/>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                                            Margin="4,0,0,0" Tag="{Binding ElementName=TbEmailCode}"
                                            Click="PasteCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M9,4 L15,4 L15,7 L9,7 Z M7,6 L4,6 L4,21 L20,21 L20,6 L17,6 M9,12 L15,12 M9,16 L15,16"/>
                                    </Button>
                                </Grid>
                                <Button x:Name="BtnChangeEmailVerify" Content="Подтвердить новую почту"
                                        Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="ChangeEmailVerify_Click"/>
                            </StackPanel>

                            <TextBlock Text="Телефон и SMS" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,16,0,0"/>
                            <TextBox x:Name="TbPhone" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="34" FontSize="13" Margin="0,6,0,0"
                                     ToolTip="+7 999 123-45-67"/>
                            <Button x:Name="BtnPhoneRequest" Content="Привязать телефон"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="PhoneRequest_Click"/>
                            <StackPanel x:Name="PhoneCodeGroup" Visibility="Collapsed">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbPhoneCode" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" CaretBrush="{DynamicResource AccentBrush}" Height="36" FontSize="16" MaxLength="6"
                                             TextAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" Tag="{Binding ElementName=TbPhoneCode}"
                                            Click="CopyCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M8,8 L20,8 L20,20 L8,20 Z M5,16 L5,4 L16,4"/>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                                            Margin="4,0,0,0" Tag="{Binding ElementName=TbPhoneCode}"
                                            Click="PasteCode_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                                  Data="M9,4 L15,4 L15,7 L9,7 Z M7,6 L4,6 L4,21 L20,21 L20,6 L17,6 M9,12 L15,12 M9,16 L15,16"/>
                                    </Button>
                                </Grid>
                                <Button x:Name="BtnPhoneVerify" Content="Подтвердить телефон"
                                        Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="PhoneVerify_Click"/>
                            </StackPanel>
                            <Button x:Name="BtnPhoneUnlink" Content="Отвязать телефон"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="PhoneUnlink_Click"/>

                            <TextBlock x:Name="TbSecurityStatus" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TbSecurityError" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Связанные сервисы -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="СВЯЗАННЫЕ СЕРВИСЫ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TbLinkedEmail" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TbLinkedGoogle" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnLinkGoogle" Grid.Column="1" Content="Привязать Google"
                                        Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                        Click="LinkGoogle_Click"/>
                                <Button x:Name="BtnUnlinkGoogle" Grid.Column="2" Content="Отвязать"
                                        Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                        Visibility="Collapsed" Click="UnlinkGoogle_Click"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TbLinkedPhone" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnUnlinkPhone" Grid.Column="1" Content="Отвязать"
                                        Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                        Visibility="Collapsed" Click="PhoneUnlink_Click"/>
                            </Grid>
                            <TextBlock x:Name="TbLinkedStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnLogout" Content="Выйти" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,22,0,0" Click="Logout_Click"/>
                    <Button x:Name="BtnClose" Content="Закрыть" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
