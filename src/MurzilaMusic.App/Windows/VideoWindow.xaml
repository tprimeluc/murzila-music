<Window x:Class="MurzilaMusic.App.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MurzilaMusic.App.Controls"
        xmlns:svc="clr-namespace:MurzilaMusic.App.Services"
        Title="Видеоклип — Murzila-Music" Height="760" Width="1180"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="#0A0A0E"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="Black">
                <MediaElement x:Name="Player" Stretch="Uniform"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="True"
                              MediaOpened="Player_MediaOpened"
                              MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed"
                              MouseLeftButtonDown="Player_MouseLeftButtonDown"/>

                <TextBlock x:Name="TbNoVideo" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}"
                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                           Text="Для этого трека нет видеоклипа. Выбери видеофайл."/>

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18"
                        Background="#88000000" CornerRadius="10" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="TbVideoTitle" Foreground="{DynamicResource TextBrush}" FontSize="16"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                        <TextBlock x:Name="TbVideoArtist" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="12" Click="Close_Click" ToolTip="Закрыть">
                    <Path Data="{svc:IconGeometry close}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.2" Fill="Transparent"/>
                </Button>

                <Button x:Name="BtnCenterPlay" Style="{StaticResource PlayCircle}"
                        Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="PlayPause_Click" Visibility="Collapsed"/>

                <Border x:Name="TbVideoErrorBorder" Visibility="Collapsed" Background="#CC2A1014"
                        CornerRadius="10" Padding="14,10" Margin="24"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock x:Name="TbVideoError" Foreground="{DynamicResource DangerBrush}" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,18,18,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Текст" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                            <Button x:Name="BtnFindLyrics" Grid.Column="1" Content="Найти текст"
                                    Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                    Click="FindLyrics_Click"/>
                        </Grid>
                        <TextBlock x:Name="TbLyricsStatus" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <controls:LyricsView x:Name="VideoLyrics" Grid.Row="1" Margin="12,0,12,10"/>

                    <StackPanel Grid.Row="2" Margin="18,0,18,18">
                        <Button x:Name="BtnPickVideo" Content="Выбрать видео"
                                Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                                Click="PickVideo_Click"/>
                        <Button x:Name="BtnBackToAudio" Content="Вернуться к аудио"
                                Style="{StaticResource PrimaryButton}" Click="BackToAudio_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="36" Height="40"
                            Click="SeekBack_Click" ToolTip="Назад 5 с">
                        <Path Data="{svc:IconGeometry seekBack}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource MutedBrush}"/>
                    </Button>
                    <Button x:Name="BtnPlayPause" Style="{StaticResource IconButton}"
                            Width="44" Height="44" FontSize="21" Click="PlayPause_Click"/>
                    <Button Style="{StaticResource IconButton}" Width="36" Height="40"
                            Click="SeekForward_Click" ToolTip="Вперёд 5 с">
                        <Path Data="{svc:IconGeometry seekForward}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource MutedBrush}"/>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TbPosition" Grid.Column="1" Text="0:00" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" Width="44" VerticalAlignment="Center" Margin="8,0,6,0"/>

                <Slider x:Name="SldPosition" Grid.Column="2" Style="{StaticResource WhiteSlider}"
                        Minimum="0" Maximum="1" Value="0"
                        PreviewMouseDown="SldPosition_PreviewMouseDown"
                        PreviewMouseUp="SldPosition_PreviewMouseUp"/>

                <TextBlock x:Name="TbDuration" Grid.Column="3" Text="0:00" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" Width="44" VerticalAlignment="Center" Margin="6,0,10,0"/>

                <Path Grid.Column="4" Data="{svc:IconGeometry volume}" Width="15" Height="15" Stretch="Uniform"
                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Fill="Transparent"
                      VerticalAlignment="Center" Margin="0,0,6,0"/>

                <Slider x:Name="SldVolume" Grid.Column="5" Style="{StaticResource WhiteSlider}"
                        Width="110" Minimum="0" Maximum="1" Value="0.8"
                        ValueChanged="SldVolume_ValueChanged"/>

                <Button x:Name="BtnFullscreen" Grid.Column="6" Style="{StaticResource IconButton}"
                        Click="Fullscreen_Click" ToolTip="Во весь экран" Margin="8,0,0,0">
                    <Path Data="{svc:IconGeometry fullscreen}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
