<Window x:Class="MurzilaMusic.App.OfflineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murzila-Music — нет сети" Height="330" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <StackPanel VerticalAlignment="Center" Margin="34">
        <TextBlock x:Name="TbTitle" Text="Murzila-Music" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18"/>
        <TextBlock x:Name="TbMessage" TextWrapping="Wrap" FontSize="17" Foreground="{DynamicResource TextBrush}"
                   LineHeight="26"/>
        <TextBlock x:Name="TbHint" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   Margin="0,12,0,0"/>
        <TextBlock x:Name="TbCode" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource DangerBrush}"
                   Margin="0,18,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <Button x:Name="BtnRetry" Content="Повтори" Style="{StaticResource PrimaryButton}"
                    Click="BtnRetry_Click" Margin="0,0,12,0"/>
            <Button x:Name="BtnOffline" Content="Работать офлайн" Style="{StaticResource GhostButton}"
                    Click="BtnOffline_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
