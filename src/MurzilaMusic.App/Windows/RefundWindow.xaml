<Window x:Class="MurzilaMusic.App.RefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Возврат на баланс — Murzila-Music" Height="440" Width="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" ResizeMode="NoResize">
    <StackPanel Margin="26">
        <TextBlock Text="Возврат на баланс" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="Если подошла не та подписка или покупка оказалась лишней — выбери заказ."
                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16"/>

        <TextBlock Text="Заказ" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,6"/>
        <ListBox x:Name="OrdersListBox" Height="120" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 Foreground="{DynamicResource TextBrush}" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Причина" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,14,0,6"/>
        <ComboBox x:Name="CbReason" Height="34" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" SelectedIndex="0">
            <ComboBoxItem Content="Не та подписка" Tag="wrong_plan"/>
            <ComboBoxItem Content="Покупка продублировалась" Tag="duplicate"/>
            <ComboBoxItem Content="Другое" Tag="other"/>
        </ComboBox>

        <TextBlock Text="Комментарий" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,14,0,6"/>
        <TextBox x:Name="TbComment" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8"/>

        <TextBlock x:Name="TbStatus" Foreground="{DynamicResource GoldBrush}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,10,0,0"/>
        <DockPanel Margin="0,18,0,0">
            <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource GhostButton}"
                    Click="BtnCancel_Click" HorizontalAlignment="Left" MinWidth="110"/>
            <Button x:Name="BtnSubmit" Content="Вернуть на баланс" Style="{StaticResource PrimaryButton}"
                    Click="BtnSubmit_Click" HorizontalAlignment="Right" MinWidth="170"/>
        </DockPanel>
    </StackPanel>
</Window>
