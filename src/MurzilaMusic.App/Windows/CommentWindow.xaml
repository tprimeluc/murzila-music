<Window x:Class="MurzilaMusic.App.CommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Комментарий к треку" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TbTrack" Foreground="{DynamicResource AccentBrush}" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock Text="Своя заметка (только на этом устройстве)" Foreground="{DynamicResource MutedBrush}"
                   FontSize="12" Margin="0,12,0,6"/>
        <TextBox x:Name="TbComment" Height="150" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10"
                 VerticalScrollBarVisibility="Auto"/>
        <DockPanel Margin="0,18,0,0">
            <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" MinWidth="110" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="130" Click="BtnSave_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
