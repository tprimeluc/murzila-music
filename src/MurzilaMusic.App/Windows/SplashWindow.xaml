<Window x:Class="MurzilaMusic.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murzila-Music" Height="420" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="28" Background="#121218" BorderBrush="#2A2A35" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.7" BlurRadius="60" ShadowDepth="10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="SplashIcon" Source="pack://siteoforigin:,,,/Assets/murzila-icon.png"
                       Width="118" Height="118" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="IconScale" ScaleX="0.55" ScaleY="0.55"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect Color="#1ED760" BlurRadius="35" Opacity="0.35"/>
                    </Image.Effect>
                </Image>

                <TextBlock x:Name="SplashTitle" Text="Murzila-Music" FontSize="34" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,20,0,0" Opacity="0"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="56,0,56,40" Width="420">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="22" Height="22" Margin="0,0,14,0">
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeDashArray="12 7"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="Spinner"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="SplashLoading" Text="Загрузка…" FontSize="16"
                               Foreground="{DynamicResource MutedBrush}" Opacity="0"/>
                </StackPanel>
                <ProgressBar x:Name="SplashProgress" Height="6" Margin="0,14,0,0"
                             Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}"
                             Background="#2A2A35" BorderThickness="0"/>
                <TextBlock x:Name="SplashStep" Text="Подготовка…" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SplashIcon" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.7"/>
                    <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.55" To="1" Duration="0:0:0.9">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.55" To="1" Duration="0:0:0.9">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SplashTitle" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="SplashLoading" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.6" Duration="0:0:0.6"/>
                    <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
