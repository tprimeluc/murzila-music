<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\murzila.ico</ApplicationIcon>
    <Version>3.6.0-beta</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Company>Murzila-Music</Company>
    <Product>Murzila-Music</Product>
    <Authors>Murzila-Music</Authors>
    <Description>Murzila-Music beta — личный плеер и локальная публикация собственных треков.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MurzilaMusic.Shared\Catalog*.cs" Link="Shared\Catalog\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\MurzilaMusic.Shared\catalog\plans.json"
                      Link="Shared\Catalog\plans.json" LogicalName="MurzilaMusic.Catalog.plans.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
