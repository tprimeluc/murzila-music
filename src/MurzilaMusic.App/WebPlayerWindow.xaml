<Window x:Class="MurzilaMusic.App.WebPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Murzila Music — веб-плеер + Desktop" Height="860" Width="1400"
        MinHeight="620" MinWidth="1000" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов: того, чего нет в вебе -->
        <Border Padding="10,8" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnBack" Content="←" Width="34" Click="BtnBack_Click" ToolTip="Назад"/>
                <Button x:Name="BtnForward" Content="→" Width="34" Margin="6,0,0,0" Click="BtnForward_Click" ToolTip="Вперёд"/>
                <Button x:Name="BtnReload" Content="⟳" Width="34" Margin="6,0,0,0" Click="BtnReload_Click" ToolTip="Перезагрузить"/>
                <Button x:Name="BtnBrowser" Content="В браузере" Margin="10,0,0,0" Click="BtnBrowser_Click" ToolTip="Открыть сайт во внешнем браузере"/>

                <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="12,0"/>

                <Button x:Name="BtnSync" Content="Синхронизировать" Click="BtnSync_Click" ToolTip="Загрузить свои треки на сервер и скачать из аккаунта"/>
                <Button x:Name="BtnFolder" Content="Папка треков" Margin="8,0,0,0" Click="BtnFolder_Click"/>
                <Button x:Name="BtnBackup" Content="Резервная копия" Margin="8,0,0,0" Click="BtnBackup_Click"/>
                <Button x:Name="BtnEqualizer" Content="Эквалайзер" Margin="8,0,0,0" Click="BtnEqualizer_Click"/>
                <Button x:Name="BtnInfo" Content="Информация о треке" Margin="8,0,0,0" Click="BtnInfo_Click"/>
                <Button x:Name="BtnLyrics" Content="Текст трека" Margin="8,0,0,0" Click="BtnLyrics_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="Web" Grid.Column="0" DefaultBackgroundColor="#07090D"/>

            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ЛОКАЛЬНАЯ БИБЛИОТЕКА · DESKTOP"
                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,10"/>
                    <TextBlock DockPanel.Dock="Top" Text="Свои файлы, метаданные и тексты — доступны даже без сайта."
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,12"/>
                    <ListBox x:Name="LbLocal" DisplayMemberPath="Title" Background="Transparent"
                             BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="10,7" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TbWebStatus" Text="Подключение…" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
