<Window x:Class="MurzilaMusic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MurzilaMusic.App"
        xmlns:controls="clr-namespace:MurzilaMusic.App.Controls"
        xmlns:conv="clr-namespace:MurzilaMusic.App.Converters"
        xmlns:svc="clr-namespace:MurzilaMusic.App.Services"
        Title="Murzila-Music" Height="800" Width="1280" MinHeight="640" MinWidth="1040"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage"/>

        <!-- Нарисованные иконки строки трека: контурный сердечко/залитое, если трек любимый -->
        <Style x:Key="RowHeartIcon" TargetType="Path">
            <Setter Property="Data" Value="{svc:IconGeometry heartOutline}"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Data" Value="{svc:IconGeometry heart}"/>
                    <Setter Property="Fill" Value="{DynamicResource FavoriteBrush}"/>
                    <Setter Property="Stroke" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowShareIcon" TargetType="Path">
            <Setter Property="Data" Value="{svc:IconGeometry share}"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleMutedBrush}"/>
            <Setter Property="Margin" Value="14,0,0,8"/>
        </Style>

        <!-- Полная строка трека -->
        <DataTemplate x:Key="TrackTemplate">
            <Border Padding="10,7" Margin="6,2" CornerRadius="14" Background="Transparent" x:Name="RowBorder">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding CoverFile, Converter={StaticResource PathToImage}}"
                           Width="48" Height="48" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="11" RadiusY="11" Rect="0,0,48,48"/>
                        </Image.Clip>
                    </Image>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DisplayArtist}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Comment}" Foreground="{DynamicResource SubtleMutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayDuration}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}"
                            Tag="{Binding Id}" Click="RowFavorite_Click" ToolTip="{DynamicResource RowFavoriteTip}">
                        <Path Style="{StaticResource RowHeartIcon}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Компактная строка трека -->
        <DataTemplate x:Key="TrackTemplateCompact">
            <Border Padding="10,3" Margin="6,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DisplayArtist}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Comment}" Foreground="{DynamicResource SubtleMutedBrush}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayDuration}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32"
                            Tag="{Binding Id}" Click="RowFavorite_Click" ToolTip="{DynamicResource RowFavoriteTip}">
                        <Path Style="{StaticResource RowHeartIcon}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== Шапка ==================== -->
        <Border Grid.Row="0" Padding="20,14" BorderThickness="0,0,0,1"
                Background="{DynamicResource HeaderGradient}" BorderBrush="{DynamicResource HeaderBorderGradient}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#1ED760" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <Image Source="pack://siteoforigin:,,,/Assets/murzila-icon.png" Width="34" Height="34"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Murzila-music" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="3.6" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TbOnlineBadge" Text="  ·  онлайн" FontSize="10" Foreground="{DynamicResource SubtleMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TbGreeting" Grid.Column="1" Text="Что хочешь послушать?"
                           FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" Margin="44,0,0,0"/>

                <Border Grid.Column="2" Width="280" Height="38" CornerRadius="12"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Path x:Name="IconSearch" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8"
                              Fill="Transparent" Margin="12,0,0,0"
                              VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBox x:Name="TbSearch" Height="36" Margin="34,0,2,0" Padding="0,7,10,7"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 TextChanged="Search_Changed" ToolTip="Поиск по своим трекам"/>
                    </Grid>
                </Border>

                <Button x:Name="BtnAccount" Grid.Column="3" Content="Войти"
                        Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="14,0,0,0"
                        Click="BtnAccount_Click" ToolTip="Аккаунт"/>

                <Button x:Name="BtnSettings" Grid.Column="4" Style="{StaticResource IconButton}"
                        Margin="8,0,0,0" Width="42" Height="42" Click="BtnSettings_Click" ToolTip="Настройки"/>
            </Grid>
        </Border>

        <!-- ==================== Основная область ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Промо-карточка -->
                        <Border CornerRadius="18" Padding="16" Margin="0,0,0,22" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PromoGradient}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{svc:IconGeometry sparkle}" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource PromoAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TbPromoBadge" Text="БЕСПЛАТНО НАВСЕГДА" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource PromoAccentBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TbPromoTitle" Text="Музыка без границ" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TbPromoText" Text="48 онлайн-возможностей. Свои треки всегда с тобой."
                                           FontSize="11" Foreground="{DynamicResource PromoTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                <Button x:Name="BtnPromoFeatures" Content="Смотреть возможности" Click="BtnFeatures_Click"
                                        HorizontalAlignment="Left" FontSize="11" Padding="12,6"
                                        Background="{DynamicResource PromoButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource PromoButtonHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TbMenuCaption" Text="МЕНЮ" Style="{StaticResource Caption}"/>
                        <Button x:Name="NavHome" Content="Главная" Style="{StaticResource NavButton}"
                                Click="NavHome_Click" ToolTip="Вся музыка и чистый поиск"/>
                        <Button x:Name="NavAll" Content="Моя музыка" Style="{StaticResource NavButton}"
                                Click="NavAll_Click"/>
                        <Button x:Name="NavFavorites" Content="Любимое" Style="{StaticResource NavButton}"
                                Click="NavFavorites_Click"/>
                        <Button x:Name="NavQuick" Content="Локальный файл" Style="{StaticResource NavButton}"
                                Click="NavQuick_Click"
                                ToolTip="MP3, FLAC, M4A, MP4, AAC, OGG, WAV, WMA и другие"/>

                        <TextBlock x:Name="TbPlaylistsCaption" Text="ПЛЕЙЛИСТЫ" Style="{StaticResource Caption}" Margin="14,20,0,8"/>
                        <ListBox x:Name="LbPlaylists" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}" DisplayMemberPath="Name" Height="210"
                                 SelectionChanged="LbPlaylists_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Button x:Name="BtnAddTracks" Content="Добавить треки" Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,0" Click="BtnAddTracks_Click"/>
                        <Button x:Name="BtnImportPlaylist" Content="Импорт плейлиста"
                                Style="{StaticResource NavButton}" Margin="0,6,0,0" Click="BtnImportPlaylist_Click"
                                ToolTip="M3U, JSON или XML со списком твоих локальных файлов"/>
                        <Button x:Name="BtnBackup" Content="Резервная копия"
                                Style="{StaticResource NavButton}" Margin="0,2,0,0" Click="BtnBackup_Click"/>
                        <Button x:Name="BtnSync" Content="Треки на других устройствах"
                                Style="{StaticResource NavButton}" Margin="0,2,0,0" Click="BtnSync_Click"
                                ToolTip="Загрузить опубликованные треки в свой сервер и скачать их в этом аккаунте"/>
                        <Button x:Name="BtnFeatures" Content="48 онлайн-возможностей"
                                Style="{StaticResource NavButton}" Margin="0,2,0,0" Click="BtnFeatures_Click"
                                ToolTip="Что уже работает в бесплатном онлайн-сервисе"/>

                        <TextBlock x:Name="TbSortLabel" Text="СОРТИРОВКА" Style="{StaticResource Caption}"
                                   Margin="14,20,0,7"/>
                        <ComboBox x:Name="CbSort" Height="34" SelectionChanged="Sort_Changed" Margin="2,0">
                            <ComboBoxItem Content="Сначала новые"/>
                            <ComboBoxItem Content="По названию"/>
                            <ComboBoxItem Content="По артисту"/>
                            <ComboBoxItem Content="По прослушиваниям"/>
                        </ComboBox>

                        <TextBlock x:Name="TbStatus" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource SubtleMutedBrush}" Margin="14,18,0,0"/>

                        <Border Margin="10,22,4,0" Padding="10" CornerRadius="10" Background="{DynamicResource OwnNoteBrush}">
                            <TextBlock x:Name="TbOnlyOwn" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource OwnNoteTextBrush}"
                                       Text="🔒 Только свои треки. Никаких чужих загрузок."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Контент -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Герой-баннер -->
                <Border Grid.Row="0" Margin="22,20,22,0" Height="168" CornerRadius="22" Padding="30,24"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource HeroGradient}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TbHeroKicker" Text="ТВОЯ МУЗЫКА. ВСЕГДА С ТОБОЙ" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource HeroKickerBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TbHeroTitle" Text="Слушай своё — без границ и чужого." FontSize="27" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TbHeroText" Text="Твои локальные треки, тексты, видео и облако в одном красивом плеере."
                                       FontSize="13" Foreground="{DynamicResource HeroTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                            <Button x:Name="BtnHeroAdd" Content="Добавить музыку" Style="{StaticResource PrimaryButton}"
                                    Padding="20,11" Click="BtnAddTracks_Click"/>
                            <Button x:Name="BtnHeroFeatures" Content="48 возможностей" Margin="0,10,0,0" Padding="20,11"
                                    Background="{DynamicResource HeroButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource HeroButtonBorderBrush}" Cursor="Hand" Click="BtnFeatures_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource PromoButtonHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Заголовок раздела -->
                <Grid Grid.Row="1" Margin="26,20,26,8">
                    <TextBlock x:Name="TbMyMusicTitle" Text="Моя музыка" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Data="{svc:IconGeometry sort}" Width="10" Height="10" Stretch="Uniform"
                              Fill="{DynamicResource SubtleMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbSortHint" Text="СОРТИРОВКА" FontSize="11" Foreground="{DynamicResource SubtleMutedBrush}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Список треков -->
                <ListBox x:Name="LbTracks" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         Margin="12,0,12,14" ItemTemplate="{StaticResource TrackTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="LbTracks_DoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuPlayItem" Header="Играть" Click="MenuPlay_Click">
                                <MenuItem.Icon>
                                    <Path Data="{svc:IconGeometry play}" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource MutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuFavoriteItem" Header="В любимое" Click="MenuFavorite_Click">
                                <MenuItem.Icon>
                                    <Path Data="{svc:IconGeometry heartOutline}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuInfoItem" Header="Информация о треке…" Click="MenuInfo_Click">
                                <MenuItem.Icon>
                                    <Path Data="{svc:IconGeometry info}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuCommentItem" Header="Комментарий" Click="MenuComment_Click">
                                <MenuItem.Icon>
                                    <Path Data="{svc:IconGeometry edit}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="MenuDeleteItem" Header="Удалить из библиотеки" Click="MenuDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="4,2" CornerRadius="14" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Экран «Сейчас играет» -->
                <Grid x:Name="NowPlayingOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                      Background="{DynamicResource NowPlayingGradient}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Border CornerRadius="20" Padding="3" Background="{DynamicResource AccentGradient}"
                                HorizontalAlignment="Center">
                            <Image x:Name="NpCover" Width="290" Height="290" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="18" RadiusY="18" Rect="0,0,290,290"/>
                                </Image.Clip>
                                <Image.Effect>
                                    <DropShadowEffect Color="#1ED760" BlurRadius="40" ShadowDepth="0" Opacity="0.28"/>
                                </Image.Effect>
                            </Image>
                        </Border>
                        <TextBlock x:Name="NpTitle" Text="—" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,26,0,0" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NpArtist" Text="—" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,6,0,0" TextAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonUp="Artist_Click"/>
                        <TextBlock x:Name="NpComment" Text="" FontSize="12" Foreground="{DynamicResource SubtleMutedBrush}"
                                   Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="320"/>
                        <controls:VisualizerControl x:Name="NpVisualizer" Height="140" MinWidth="240"
                                                    HorizontalAlignment="Stretch" Margin="0,22,0,0"/>
                        <Button x:Name="BtnBackToPlayer" Content="К плееру" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Center" Margin="0,20,0,0" Click="CloseNowPlaying_Click"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource DeepPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TbLyricsTitle" Text="Текст" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="TbLyricsStatus" Foreground="{DynamicResource SubtleMutedBrush}" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnOpenLyricsFolder" Style="{StaticResource IconButton}"
                                            Click="BtnOpenLyricsFolder_Click" ToolTip="Открыть папку текстов"/>
                                    <Button x:Name="BtnEditLyrics" Style="{StaticResource IconButton}"
                                            Click="BtnEditLyrics_Click" ToolTip="Свой текст"/>
                                    <Button x:Name="BtnFindLyrics" Content="Найти текст"
                                            Style="{StaticResource GhostButton}" Padding="12,7" FontSize="12"
                                            Click="BtnFindLyrics_Click"/>
                                </StackPanel>
                            </Grid>
                            <controls:LyricsView x:Name="NpLyrics" Grid.Row="1" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== Нижний плеер ==================== -->
        <Border Grid.Row="2" Padding="14,10" BorderThickness="0,1,0,0"
                Background="{DynamicResource PlayerGradient}" BorderBrush="{DynamicResource HeaderBorderGradient}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="CurrentCover" Width="56" Height="56" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,56,56"/>
                        </Image.Clip>
                    </Image>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="180">
                        <TextBlock x:Name="CurrentTitle" Text="Ничего не играет" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CurrentArtist" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Cursor="Hand"
                                   MouseLeftButtonUp="Artist_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnPlayerFavorite" Style="{StaticResource IconButton}"
                            Click="BtnPlayerFavorite_Click" ToolTip="{DynamicResource RowFavoriteTip}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnShuffle" Style="{StaticResource IconButton}"
                                Click="BtnShuffle_Click" ToolTip="Перемешать треки"/>
                        <Button x:Name="BtnPrev" Style="{StaticResource IconButton}"
                                FontSize="21" Click="BtnPrev_Click"/>
                        <Button x:Name="BtnPlay" Style="{StaticResource PlayCircle}"
                                Click="BtnPlay_Click" Margin="10,0"/>
                        <Button x:Name="BtnNext" Style="{StaticResource IconButton}"
                                FontSize="21" Click="BtnNext_Click"/>
                        <Button x:Name="BtnRepeat" Style="{StaticResource IconButton}"
                                Click="BtnRepeat_Click" ToolTip="Повтор: выключен"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TbTime" Text="0:00" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   Width="44" VerticalAlignment="Center" Cursor="Hand"
                                   ToolTip="Нажми, чтобы показать остаток"
                                   MouseLeftButtonUp="TbTime_Click"/>
                        <Slider x:Name="SldProgress" Style="{StaticResource WhiteSlider}"
                                Value="0" Margin="6,0" Minimum="0" Maximum="1"
                                PreviewMouseDown="SldProgress_PreviewMouseDown"
                                PreviewMouseUp="SldProgress_PreviewMouseUp"/>
                        <TextBlock x:Name="TbTotal" Text="0:00" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   Width="38" VerticalAlignment="Center" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnAudioOutput" Style="{StaticResource IconButtonBar}"
                            Click="BtnAudioOutput_Click" ToolTip="Куда играть звук"/>
                    <Button x:Name="BtnLyrics" Style="{StaticResource IconButtonBar}"
                            Click="BtnLyrics_Click" ToolTip="Текст и визуализатор"/>
                    <Button x:Name="BtnVideo" Style="{StaticResource IconButtonBar}"
                            Click="BtnVideo_Click" ToolTip="Видеоклип"/>
                    <Button x:Name="BtnHeadphones" Style="{StaticResource IconButtonBar}"
                            Visibility="Collapsed" Click="BtnHeadphones_Click" ToolTip="Вернуться к аудио"/>
                    <Button x:Name="BtnEqualizer" Style="{StaticResource IconButtonBar}"
                            Click="BtnEqualizer_Click" ToolTip="Эквалайзер"/>
                    <Button x:Name="BtnDownload" Style="{StaticResource IconButtonBar}"
                            Click="BtnDownload_Click" ToolTip="Скачать трек"/>
                    <Button x:Name="BtnPlaylist" Style="{StaticResource IconButtonBar}"
                            Click="BtnPlaylist_Click" ToolTip="Добавить в плейлист"/>
                    <StackPanel Orientation="Horizontal" Width="132" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BtnMute" Style="{StaticResource IconButton}" Width="26"
                                Click="BtnMute_Click" ToolTip="Выключить звук" Margin="0,0,4,0"/>
                        <Slider x:Name="SldVolume" Style="{StaticResource WhiteSlider}" Width="100"
                                Value="0.75" Minimum="0" Maximum="1"
                                ValueChanged="SldVolume_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Сезонные эффекты за интерфейсом: не загораживают текст и не мешают кликам -->
        <controls:SeasonalEffectsControl x:Name="Season" Grid.RowSpan="3" Panel.ZIndex="-1"
                                         Opacity="0.35" IsHitTestVisible="False"/>

        <!-- Понятная индикация долгих операций -->
        <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed"
              Background="{DynamicResource OverlayBrush}">
            <Border CornerRadius="18" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="340" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource MenuGradient}">
                <StackPanel>
                    <TextBlock Text="MURZILA-MUSIC" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BusyText" Text="Загрузка…" Foreground="{DynamicResource TextBrush}" FontSize="15"
                               Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <ProgressBar x:Name="BusyProgress" Height="6" Margin="0,16,0,0"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentGradient}"
                                 Background="{DynamicResource BorderSoftBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
