<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Murzila Music" Manufacturer="MursikT7 Corporation" Version="3.6.0" UpgradeCode="6D2B4E5A-8C31-4F2A-9E77-0A1B2C3D4E5F" Language="1049" Codepage="65001" InstallerVersion="200" Scope="perUserOrMachine" Compressed="yes">
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\Assets\murzila.ico" />
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Murzila Music">
        <Directory Id="Dir_Assets" Name="Assets">
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MurzilaMenu" Name="Murzila Music" />
    </StandardDirectory>
    <ComponentGroup Id="AppFiles">
      <Component Id="C_MurzilaMusic_App_deps_json" Directory="INSTALLFOLDER" Guid="*"><File Id="F_MurzilaMusic_App_deps_json" Source="$(var.SourceDir)\MurzilaMusic.App.deps.json" KeyPath="yes" /></Component>
      <Component Id="C_MurzilaMusic_App_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_MurzilaMusic_App_dll" Source="$(var.SourceDir)\MurzilaMusic.App.dll" KeyPath="yes" /></Component>
      <Component Id="C_MurzilaMusic_App_exe" Directory="INSTALLFOLDER" Guid="*"><File Id="F_MurzilaMusic_App_exe" Source="$(var.SourceDir)\MurzilaMusic.App.exe" KeyPath="yes"><Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Murzila Music" WorkingDirectory="INSTALLFOLDER" Advertise="no" Icon="AppIcon" /><Shortcut Id="StartMenuShortcut" Directory="MurzilaMenu" Name="Murzila Music" WorkingDirectory="INSTALLFOLDER" Advertise="no" Icon="AppIcon" /></File></Component>
      <Component Id="C_MurzilaMusic_App_pdb" Directory="INSTALLFOLDER" Guid="*"><File Id="F_MurzilaMusic_App_pdb" Source="$(var.SourceDir)\MurzilaMusic.App.pdb" KeyPath="yes" /></Component>
      <Component Id="C_MurzilaMusic_App_runtimeconfig_json" Directory="INSTALLFOLDER" Guid="*"><File Id="F_MurzilaMusic_App_runtimeconfig_json" Source="$(var.SourceDir)\MurzilaMusic.App.runtimeconfig.json" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_Asio_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_Asio_dll" Source="$(var.SourceDir)\NAudio.Asio.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_Core_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_Core_dll" Source="$(var.SourceDir)\NAudio.Core.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_dll" Source="$(var.SourceDir)\NAudio.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_Midi_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_Midi_dll" Source="$(var.SourceDir)\NAudio.Midi.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_Vorbis_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_Vorbis_dll" Source="$(var.SourceDir)\NAudio.Vorbis.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_Wasapi_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_Wasapi_dll" Source="$(var.SourceDir)\NAudio.Wasapi.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_WinForms_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_WinForms_dll" Source="$(var.SourceDir)\NAudio.WinForms.dll" KeyPath="yes" /></Component>
      <Component Id="C_NAudio_WinMM_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NAudio_WinMM_dll" Source="$(var.SourceDir)\NAudio.WinMM.dll" KeyPath="yes" /></Component>
      <Component Id="C_NVorbis_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_NVorbis_dll" Source="$(var.SourceDir)\NVorbis.dll" KeyPath="yes" /></Component>
      <Component Id="C_TagLibSharp_dll" Directory="INSTALLFOLDER" Guid="*"><File Id="F_TagLibSharp_dll" Source="$(var.SourceDir)\TagLibSharp.dll" KeyPath="yes" /></Component>
      <Component Id="C_Assets_murzila_icon_png" Directory="Dir_Assets" Guid="*"><File Id="F_Assets_murzila_icon_png" Source="$(var.SourceDir)\Assets\murzila-icon.png" KeyPath="yes" /></Component>
      <Component Id="C_Assets_murzila_ico" Directory="Dir_Assets" Guid="*"><File Id="F_Assets_murzila_ico" Source="$(var.SourceDir)\Assets\murzila.ico" KeyPath="yes" /></Component>
      <Component Id="C_Assets_visualizer_reference_png" Directory="Dir_Assets" Guid="*"><File Id="F_Assets_visualizer_reference_png" Source="$(var.SourceDir)\Assets\visualizer-reference.png" KeyPath="yes" /></Component>
    </ComponentGroup>
    <Feature Id="MainFeature" Title="Murzila Music" Level="1" ConfigurableDirectory="INSTALLFOLDER"><ComponentGroupRef Id="AppFiles" /></Feature>
  </Package>
</Wix>
